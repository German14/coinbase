{
  "name": "coinbase-trading-bot",
  "version": "1.0.0",
  "description": "Bot de trading automatizado para Coinbase con indicadores técnicos + IA",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "watch": "ts-node-dev --respawn --transpile-only src/index.ts",
    "balance": "ts-node src/balance.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "chalk": "^4.1.2",
    "dotenv": "^16.4.5",
    "form-data": "^4.0.5",
    "groq-sdk": "^1.1.2",
    "jsonwebtoken": "^9.0.3",
    "node-fetch": "^2.7.0",
    "undici": "^8.1.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.0.0",
    "@types/node-fetch": "^2.6.13",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
